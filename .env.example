# ==============================================================================
# NexusBoard SaaS Platform - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in the values
# cp .env.example .env.local
# ==============================================================================

# ---- DATABASE ----
# SQLite for local development (already configured)
DATABASE_URL="file:./db/custom.db"

# PostgreSQL for production (Neon)
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/nexusboard?sslmode=require"

# ---- AUTHENTICATION ----
# Required: Generate with `openssl rand -base64 32`
AUTH_SECRET="your-auth-secret-here-change-this"

# ---- ENCRYPTION (OWASP A02) ----
# Required for PII field encryption (emails, phones, IDs)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ---- APPLICATION ----
# Public URL of the application (used for email links, webhooks, etc.)
APP_URL="http://localhost:3000"
# NODE_ENV is auto-set by Next.js, but you can override
# NODE_ENV="development"

# ---- RAZORPAY (Payments) ----
# Required for production payment processing
# Get from: https://dashboard.razorpay.com/settings/api-keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Public key (exposed to client-side)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- RESEND (Email) ----
# Required for production email delivery
# Get from: https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ---- CLOUDINARY (File Storage) ----
# Required for production essay PDF uploads
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
